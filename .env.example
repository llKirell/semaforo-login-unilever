# Copia este archivo a ".env" y rellena tus datos reales.
# ".env" NUNCA se sube a git (esta en .gitignore).

# --- Acceso a AppDinet / W4W ---
# Misma convencion que el robot de referencia (w4w-legacy-bridge).
DINET_USER=
DINET_PASS=

# --- Endpoint de Inventario Saldo ---
# Se completa DESPUES de correr el script de descubrimiento.
# Dejar vacio por ahora.
W4W_SALDO_ENDPOINT=

# --- Telegram (aun NO se usa, se documenta para fases futuras) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
